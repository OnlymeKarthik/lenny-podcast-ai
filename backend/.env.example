# ==========================================
# REQUIRED VARIABLES
# ==========================================

# Database connection string (Default is for the docker-compose setup)
DATABASE_URL=postgresql://postgres:password@db:5432/lenny_assistant

# Ollama local endpoint (Default for Docker accessing host network)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==========================================
# OPTIONAL VARIABLES
# ==========================================

# Anthropic API Key (Required ONLY if you toggle to Claude in the UI)
# NEVER commit your actual API key. Keep it safe!
ANTHROPIC_API_KEY=sk-ant-your-key-here
