# ==========================================
# REQUIRED VARIABLES
# ==========================================

# Database connection string (Default is for the docker-compose setup)
DATABASE_URL=postgresql://postgres:password@db:5432/lenny_assistant

# Ollama local endpoint (Default for Docker accessing host network)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==========================================
# OPTIONAL VARIABLES
# ==========================================

# Anthropic API Key (Required ONLY if you toggle to Anthropic Claude in the UI)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key (Alternative cloud provider — uncomment and set if preferred)
# OPENAI_API_KEY=sk-your-key-here

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
